class Node:
    def __init__(self, name, chain):
        self.name = name
        self.chain = [Block(b.index, b.data, b.previous_hash)
                      for b in chain]   
        for i, b in enumerate(self.chain):
            b.hash = chain[i].hash  

    def validate(self):
        for i in range(1, len(self.chain)):
            if self.chain[i].previous_hash != self.chain[i-1].hash:
                return f"INVALID at block {i}"
        return "VALID"

