class Block:
    def __init__(self, index, data, previous_hash):
        self.index = index
        self.data = data
        self.previous_hash = previous_hash
        self.timestamp = str(time.time())
        self.hash = self.compute_hash()

    def compute_hash(self):
        s = f"{self.index}{self.data}{self.previous_hash}{self.timestamp}"
        return hashlib.sha256(s.encode()).hexdigest()

class Blockchain:
    def __init__(self):
        self.chain = [Block(0, "Genesis", "0")]
    def add(self, data):
        prev = self.chain[-1]
        self.chain.append(Block(len(self.chain), data, prev.hash))
    def is_valid(self):
        for i in range(1, len(self.chain)):
            cur, prev = self.chain[i], self.chain[i-1]
            if cur.hash != cur.compute_hash():
                return False, f"Block {i} hash invalid"
            if cur.previous_hash != prev.hash:
                return False, f"Block {i} broken link"
        return True, "Chain is VALID"

